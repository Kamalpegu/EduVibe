# Cloudflare Workers AI credentials.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# OAuth 2.0 Web application client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
OPENAI_API_KEY=your-openai-api-key

# Required for Vercel deployment: Neon Postgres connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required for Vercel deployment: Vercel Blob read-write token.
# Create/connect a Blob store in Vercel, then add its token as an environment variable.
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token